{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/event-worker.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/instagram-refresh",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/event-worker",
      "schedule": "0 1 * * *"
    }
  ]
}
