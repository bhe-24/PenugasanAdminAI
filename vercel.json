{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/central?action=cron-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/central?action=cron-ultah",
      "schedule": "0 0 * * *"
    }
  ]
}
